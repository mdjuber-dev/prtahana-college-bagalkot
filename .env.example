# Database Connection (PostgreSQL / Neon)
DATABASE_URL=postgresql://neondb_owner:password@host/neondb?sslmode=require

# Database timeouts (optional)
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=12000

# Server Authentication & Configuration
ADMIN_PASSWORD=admin@prarthanapu
ADMIN_SESSION_SECRET=your_secure_random_session_secret_key
PORT=3000
FRONTEND_URL=http://localhost:5173
PRODUCTION_FRONTEND_URL=https://your-college-domain.com

# Optional Frontend API Base URL (leave empty for same-origin deployment)
VITE_API_BASE_URL=https://your-backend-domain.com
VITE_API_URL=https://your-backend-domain.com


